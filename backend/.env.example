# Neon Postgres Configuration
# Get from: Neon Console → Connection Details (use POOLED connection string)
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/dbname

# SerpAPI Configuration  
# Get from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Gemini Configuration
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
LOG_LEVEL=INFO
MAX_SEARCH_RESULTS=10

# Set to true to use mock data instead of real APIs
MOCK_MODE=false
